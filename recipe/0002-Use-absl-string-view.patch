From 5a0ddb8f5e2f0f7c2a8e3d5f6b7c8d9e0f1a2b3c Mon Sep 17 00:00:00 2001
From: "Uwe L. Korn" <uwe.korn@quantco.com>
Date: Thu, 25 Jun 2026 14:00:00 +0100
Subject: [PATCH] Align StringViewArg with conda-forge protobuf

The conda-forge protobuf package does not define
PROTOBUF_TEMPORARY_ENABLE_STRING_VIEW_DESCRIPTOR_DATABASE, so
PROTOBUF_FUTURE_STRING_VIEW_DESCRIPTOR_DATABASE is not set and
StringViewArg in descriptor_database.h remains `const std::string&`.
The upstream cel-expr-python source uses `std::string_view`, which
doesn't match, causing override build failures.

---
 cel_expr_python/py_descriptor_database.h | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/cel_expr_python/py_descriptor_database.h b/cel_expr_python/py_descriptor_database.h
index 3f2a5c7..b8c1e3d 100644
--- a/cel_expr_python/py_descriptor_database.h
+++ b/cel_expr_python/py_descriptor_database.h
@@ -19,6 +19,7 @@
 
 #include <Python.h>  // IWYU pragma: keep - Needed for PyObject
 
+#include <string>  // Needed for std::string
 #include <string_view>  // IWYU pragma: keep - Needed for string_view in OSS
 
 #include "google/protobuf/descriptor.pb.h"
@@ -29,7 +30,7 @@
 // A DescriptorDatabase that uses a Python DescriptorPool to find descriptors.
 class PyDescriptorDatabase : public google::protobuf::DescriptorDatabase {
  private:
-  using StringViewArg = std::string_view;
+  using StringViewArg = const std::string&;
  public:
   explicit PyDescriptorDatabase(PyObject* py_descriptor_pool);
   ~PyDescriptorDatabase() override;
